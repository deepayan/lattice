msgstr "'dimnames' proporcionado tiene una longitud incorrecta"

msgid "some components of supplied 'dimnames' have wrong length"
msgstr ""
"algunos componentes del 'dimnames' suministrados tienen una longitud "
"incorrecta"

msgid "mean"
msgstr "promedio (mean)"

msgid "difference"
msgstr "diferencia"

