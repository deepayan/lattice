msgstr "El objeto 'trellis' solicitado no se guardó"

msgid "Inappropriate value of 'as.table'"
msgstr "Valor inapropiado de 'as.table'"

msgid "'par.strip.text' must be a list"
msgstr "'par.strip.text' debe ser una lista"

msgid "'par.settings' must be a list"
msgstr "'par.settings' debe ser una lista"

msgid "'plot.args' must be a list"
msgstr "'plot.args' debe ser una lista"

msgid "'lattice.options' must be a list"
msgstr "'lattice.options' debe ser una lista"

msgid "Invalid value of 'perm.cond'"
msgstr "Valor no válido de 'perm.cond'"

msgid "Note: 'auto.key' ignored since legend already present.\nUse 'update(..., legend = NULL)' to remove existing legend(s)"
msgstr ""
"Nota: 'auto.key' se ignora porque la leyenda ya está presente.\n"
"Utilice 'update(..., legend = NULL)' para eliminar las leyendas existentes."

msgid "log scales cannot be changed via 'update'"
msgstr "las escalas logarítmicas no se pueden cambiar mediante 'update'"

msgid "the at and labels components of scales may not be lists when relation = same"
msgstr ""
"los componentes at y labels de las escalas pueden no ser listas cuando "
"relación = igual"

